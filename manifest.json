{
  "id": "/?source=pwa",
  "name": "Razian Price — بازار لحظه‌ای",
  "short_name": "Razian",
  "description": "قیمت لحظه‌ای طلا، نفت، ارز، رمزارز و بازار ایران با هشدار، نمودار و پورتفولیو",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0a0f1c",
  "theme_color": "#0a0f1c",
  "lang": "fa",
  "dir": "rtl",
  "categories": ["finance", "productivity", "utilities"],
  "prefer_related_applications": false,

  "icons": [
    {
      "src": "/icons/razian-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/razian-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/razian-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "screenshots": [
    {
      "src": "/screenshots/market.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "نمای بازار"
    },
    {
      "src": "/screenshots/chart.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "نمودار کندل‌استیک"
    }
  ],

  "shortcuts": [
    {
      "name": "طلا و سکه",
      "short_name": "طلا",
      "url": "/?tab=market&filter=gold",
      "icons": [{ "src": "/icons/gold-96.png", "sizes": "96x96" }]
    },
    {
      "name": "دلار و ارز",
      "short_name": "ارز",
      "url": "/?tab=market&filter=fx",
      "icons": [{ "src": "/icons/fx-96.png", "sizes": "96x96" }]
    },
    {
      "name": "پورتفولیو",
      "short_name": "پورتفولیو",
      "url": "/?tab=portfolio",
      "icons": [{ "src": "/icons/wallet-96.png", "sizes": "96x96" }]
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "protocol_handlers": [
    {
      "protocol": "web+razian",
      "url": "/?deeplink=%s"
    }
  ]
}
